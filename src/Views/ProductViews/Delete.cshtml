@model ProductApi.src.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row">
    <div class="col-md-8">

        <h1>Delete Product</h1>

        <div class="alert alert-danger">
            <strong>Are you sure?</strong>
            This product will be permanently deleted.
        </div>

        <div class="card mb-4">
            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-3">
                        ID
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Id
                    </dd>

                    <dt class="col-sm-3">
                        Name
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-3">
                        Description
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-3">
                        Price
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Price.ToString("C")
                    </dd>

                </dl>

            </div>
        </div>

        <form asp-controller="ProductsViews"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('Are you sure you want to delete this product?');">
                Delete
            </button>

            <a asp-controller="ProductsViews"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>