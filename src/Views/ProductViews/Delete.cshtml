@model ProductApi.src.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "ProductViews")">Products</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>

        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Product</h5>
            </div>
            <div class="card-body">

                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                    <div>
                        You are about to <strong>permanently delete</strong> this product.
                        This action <strong>cannot be undone</strong>.
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <hr class="my-2" />

                    <dt class="col-sm-4 text-muted">Product Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <hr class="my-2" />

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    <hr class="my-2" />

                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-success">@Model.Price.ToString("C")</span>
                    </dd>
                </dl>

            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-controller="ProductViews"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      id="deleteForm">

                    @Html.AntiForgeryToken()

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmDeleteBtn">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                </form>

                <a asp-controller="ProductViews"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
            </div>
        </div>

    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete
                <strong>"@Model.Name"</strong>?
                This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" id="finalDeleteBtn">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            // Open confirmation modal first
            $('#confirmDeleteBtn').on('click', function () {
                deleteModal.show();
            });

            // On final confirm — disable button, submit form
            $('#finalDeleteBtn').on('click', function () {
                $(this).prop('disabled', true)
                       .html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting…');
                $('#deleteForm').submit();
            });
        });
    </script>
}
