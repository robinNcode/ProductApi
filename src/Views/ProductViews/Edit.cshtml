@model ProductApi.src.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="row">
    <div class="col-md-8">
        <h1>Edit Product</h1>

        <hr />

        <form asp-controller="ProductsViews"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Name"
                       class="form-label">
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter product name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter product description">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Price"
                       class="form-label">
                </label>

                <input asp-for="Price"
                       type="number"
                       class="form-control"
                       placeholder="Enter price"
                       step="0.01"
                       min="0.01" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="mt-4">
                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="ProductsViews"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}