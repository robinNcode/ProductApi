@model List<ProductApi.src.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-box-seam me-2"></i>Products</h2>
    <a href="@Url.Action("Create", "ProductViews")" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Add Product
    </a>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0" id="productsTable">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th style="width:160px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int row = 1; }
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@product.Name</td>
                            <td>@(product.Description ?? "—")</td>
                            <td>@product.Price.ToString("C")</td>
                            <td>
                                <a href="@Url.Action("Details", "ProductViews", new { id = product.Id })"
                                   class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", "ProductViews", new { id = product.Id })"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("Delete", "ProductViews", new { id = product.Id })"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                        row++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted mt-2">
        <small>Showing @Model.Count product(s)</small>
    </p>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-3 text-muted"></i>
        <h4 class="mt-3 text-muted">No products found</h4>
        <p class="text-muted">Get started by adding your first product.</p>
        <a href="@Url.Action("Create", "ProductViews")" class="btn btn-success mt-2">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </a>
    </div>
}
